# ==============================================================================
# RAMPRS Web Storefront & Admin Environment Configuration (apps/web/.env.local)
# ==============================================================================
# In production, replace with your Render backend URL (e.g., https://ramprs-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Use ONLY the anon public key here (NEVER the service role key!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# --- Razorpay Public Key (Client Checkout Modal) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
