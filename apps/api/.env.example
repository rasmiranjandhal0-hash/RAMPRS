# ==============================================================================
# RAMPRS API Environment Configuration (apps/api/.env)
# ==============================================================================
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-supabase-project.supabase.co
# CRITICAL: Service Role Key MUST be kept secret on the server!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Payment Gateway (Razorpay Dashboard -> Settings -> API Keys) ---
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret (created when configuring webhook in Razorpay Dashboard)
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Email Notifications (Resend Dashboard -> API Keys) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=RAMPRS Orders <onboarding@resend.dev>
