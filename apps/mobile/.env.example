# ==============================================================================
# RAMPRS Mobile App Environment Configuration (apps/mobile/.env)
# ==============================================================================
# In production, replace with your Render backend URL (e.g., https://ramprs-api.onrender.com)
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Supabase (Project Settings -> API) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Use ONLY the anon public key here (NEVER the service role key!)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# --- Razorpay Public Key ---
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
